{
    // PythonのデフォルトフォーマッタをBlackに設定
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            // 保存時にRuffでインポート順の整理と自動修正を実行
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
        }
    },
    // 全角スペースを可視化（zenkakuプラグインの設定）
    "zenkaku.enabled": true,
    
    "cSpell.words": [
        "cmap",
        "familyname",
        "fontforge",
        "fontname",
        "fstypepermitted",
        "Futura",
        "glyf",
        "gmtime",
        "hhea",
        "hmtx",
        "nbspace",
        "nonexisted",
        "notdef",
        "pathops",
        "recalc",
        "sfnt",
        "skia",
        "skyrim",
        "Subsetter",
        "Typog",
        "unicodes",
        "winkern"
    ]
}